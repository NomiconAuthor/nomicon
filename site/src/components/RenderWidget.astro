---
/** Mounts one of the rendering lesson widgets (src/render/). */
interface Props {
  kind: 'pipeline' | 'raster' | 'perspective' | 'depth' | 'overdraw';
}
const { kind } = Astro.props;
---

<render-widget data-kind={kind}><p class="ll-loading">Loading…</p></render-widget>

<script>
  import '../engine/engine.css';
  import '../render/render.css';

  class RenderWidget extends HTMLElement {
    async connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = '1';
      const k = this.dataset.kind;
      const w = await import('../render/widgets');
      if (k === 'pipeline') new w.PipelineViz(this);
      else if (k === 'raster') new w.RasterViz(this);
      else if (k === 'perspective') new w.PerspectiveViz(this);
      else if (k === 'depth') new w.DepthViz(this);
      else if (k === 'overdraw') new w.OverdrawViz(this);
    }
  }
  if (!customElements.get('render-widget')) customElements.define('render-widget', RenderWidget);
</script>

<style>
  render-widget {
    display: block;
  }
</style>
