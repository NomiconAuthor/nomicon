---
/** "A frame in detail": one recorded frame of a scenario in src/flecs/frame/scenarios.ts. */
interface Props {
  scenario: string;
  caption?: string;
}
const { scenario, caption } = Astro.props;
---

<figure class="ffr-fig">
  <flecs-frame data-scenario={scenario}><p class="ffr-loading">Loading flecs…</p></flecs-frame>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import '../flecs/frame/frame.css';
  import { FrameView } from '../flecs/frame/view';
  import { FRAME_SCENARIOS } from '../flecs/frame/scenarios';

  class FlecsFrameElement extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = '1';
      const sc = FRAME_SCENARIOS[this.dataset.scenario ?? ''];
      if (!sc) {
        this.textContent = `Unknown scenario: ${this.dataset.scenario}`;
        return;
      }
      void new FrameView(this, sc).init();
    }
  }
  if (!customElements.get('flecs-frame')) customElements.define('flecs-frame', FlecsFrameElement);
</script>

<style>
  .ffr-fig {
    margin: 24px 0;
  }
  figcaption {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: -10px;
  }
  flecs-frame {
    display: block;
  }
  .ffr-loading {
    color: var(--muted);
  }
</style>
