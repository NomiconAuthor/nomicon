---
import Base from '../layouts/Base.astro';
---

<Base
  title="Feel Lab"
  section="feel-lab"
  description="A platformer with every game-feel setting exposed: acceleration, jump height and timing, fall gravity, variable jumps, coyote time, jump buffering, corner correction, input delay, camera smoothing, dead zones, look-ahead and juice."
>
  <h1 style="position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap">Feel lab</h1>
  <main id="app" class="app-root"></main>
  <noscript><p>The Feel Lab needs JavaScript.</p></noscript>
</Base>

<script>
  import '../lab/lab.css';
  import '../feel/feel.css';
  import { FeelApp } from '../feel/app';

  new FeelApp(document.getElementById('app')!);
</script>
