---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';
import { OUTLINE } from '../../render/outline';

const modules = import.meta.glob<{ frontmatter: { title: string; order: number; summary: string }; url: string }>('./*.mdx', { eager: true });
const written = new Map(Object.entries(modules).map(([f, m]) => [f.replace(/^\.\/|\.mdx$/g, ''), { ...m.frontmatter, url: m.url }]));
const listed = new Set(OUTLINE.flatMap((p) => p.lessons.map((l) => l.slug).filter(Boolean)));
for (const slug of written.keys()) if (!listed.has(slug)) throw new Error(`rendering/${slug}.mdx is not in src/render/outline.ts`);
// Written lessons are numbered in order; planned ones are shown as "coming".
let n = 0;
const parts = OUTLINE.map((p) => ({
  ...p,
  lessons: p.lessons.map((l) => {
    const w = l.slug ? written.get(l.slug) : undefined;
    return w ? { title: w.title, summary: w.summary, url: w.url, n: ++n } : { title: l.title, summary: l.summary, url: null, n: 0 };
  }),
}));
---

<Base title="Rendering" section="rendering" description="Interactive lessons on real-time rendering for game programmers: the GPU pipeline, rasterisation and depth on a software rasteriser you can step pixel by pixel, then engine-side rendering, lighting and performance on the real GPU.">
  <main class="flecs-index">
    <p class="kicker">Lessons</p>
    <h1>How GPUs draw a frame, and how engines feed them</h1>
    <p class="lede">
      Four parts. <b>Pipeline fundamentals</b> run on a small software rasteriser written for this site, which you can pause after any vertex,
      triangle or pixel. The later parts, on <b>engine-side rendering</b>, <b>lighting and shading</b> and <b>performance</b>, will run on your
      real GPU through WebGPU. Lessons marked <span class="soon">coming</span> are planned and not written yet.
    </p>
    {
      parts.map((p) => (
        <section class="part">
          <h2 class="part-h">{p.name}</h2>
          <p class="runs">{p.runs}</p>
          <ol class="lesson-list">
            {p.lessons.map((l) =>
              l.url ? (
                <li>
                  <a href={l.url}>
                    <span class="n">{l.n}</span>
                    <span class="t">{l.title}</span>
                    <span class="s">{l.summary}</span>
                  </a>
                </li>
              ) : (
                <li class="planned">
                  <div>
                    <span class="n">·</span>
                    <span class="t">
                      {l.title} <span class="soon">coming</span>
                    </span>
                    <span class="s">{l.summary}</span>
                  </div>
                </li>
              ),
            )}
          </ol>
        </section>
      ))
    }
    <p class="fine">The software rasteriser snaps positions to 1/256 pixel and decides coverage with exact integer arithmetic, so it draws the same pixels in every browser. Code examples are in C++.</p>
  </main>
</Base>

<style>
  .flecs-index {
    max-width: 900px;
    margin: 0 auto;
    padding: 16px 0 80px;
  }
  .part-h {
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 28px 0 2px;
  }
  .runs {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0 0 10px;
  }
  .flecs-index h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 4px 0 12px;
  }
  .kicker {
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }
  .lede {
    color: var(--body);
    font-size: 1.05rem;
    max-width: 70ch;
  }
  .lesson-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .lesson-list a,
  .lesson-list .planned > div {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    gap: 2px 12px;
    padding: 14px 18px;
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
  }
  .lesson-list a:hover {
    border-color: var(--accent);
  }
  .lesson-list .planned > div {
    background: transparent;
    border-style: dashed;
  }
  .planned .t {
    color: var(--body);
  }
  .planned .s {
    color: var(--muted);
  }
  .n {
    grid-row: span 2;
    font-family: var(--f-mono);
    color: var(--accent);
    font-size: 1.2rem;
  }
  .planned .n {
    color: var(--muted);
  }
  .t {
    color: var(--ink);
    font-weight: 500;
    font-size: 1.05rem;
  }
  .s {
    color: var(--body);
    font-size: 0.92rem;
  }
  .soon {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 1px 7px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
    vertical-align: 2px;
  }
  .fine {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
