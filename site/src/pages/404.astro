---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist on Nomicon.">
  <main class="nf">
    <p class="kicker">404</p>
    <h1>This page isn't in the book</h1>
    <p class="lede">
      The link may be old, or mistyped. Lessons sometimes move when the site is reorganised; search usually finds where one went.
    </p>
    <ul class="nf-links">
      <li><a href="/">Home</a></li>
      <li><a href="/engine/">Engine fundamentals</a></li>
      <li><a href="/flecs/">flecs lessons</a></li>
      <li><a href="/ai/">Game AI</a></li>
      <li><a href="/labs/">Labs</a></li>
    </ul>
    <p class="fine">Press <kbd>/</kbd> or <kbd>Ctrl</kbd> <kbd>K</kbd> to search.</p>
  </main>
</Base>

<style>
  .nf {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 0 96px;
  }
  .kicker {
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }
  .nf h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 4px 0 12px;
  }
  .lede {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .nf-links {
    list-style: none;
    padding: 0;
    margin: 24px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .nf-links a {
    display: inline-block;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
  }
  .nf-links a:hover {
    border-color: var(--accent);
  }
  .fine {
    color: var(--muted);
    font-size: 0.85rem;
  }
  kbd {
    font-family: var(--f-mono);
    font-size: 0.8rem;
    padding: 1px 5px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
</style>
