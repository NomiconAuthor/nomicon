---
import Base from '../../layouts/Base.astro';
import '../../styles/lesson.css';
import LearnMore from '../../components/lesson/FlecsLearnMore.mdx';
import { FLECS_COMMIT, FLECS_DATE } from '../../flecs/version';

const modules = import.meta.glob<{ frontmatter: { title: string; order: number; summary: string; part?: string }; url: string }>('./*.mdx', { eager: true });
const lessons = Object.values(modules)
  .map((m) => ({ ...m.frontmatter, url: m.url }))
  .sort((a, b) => a.order - b.order)
  .map((l, k) => ({ ...l, n: k + 1 }));
// Group consecutive lessons by their `part` frontmatter.
const parts: Array<{ name: string; lessons: typeof lessons }> = [];
for (const l of lessons) {
  const name = l.part ?? '';
  if (!parts.length || parts.at(-1)!.name !== name) parts.push({ name, lessons: [] });
  parts.at(-1)!.lessons.push(l);
}
---

<Base title="flecs lessons" section="flecs" description="Interactive lessons on the flecs ECS, with a storage debugger running real flecs in your browser.">
  <main class="flecs-index">
    <p class="kicker">Lessons</p>
    <h1>flecs, from the storage up</h1>
    <p class="lede">
      These lessons follow the <a href="https://www.flecs.dev/flecs/">flecs documentation</a>, but with a debugger alongside. Every
      example runs real flecs, compiled to WebAssembly from the master branch (commit <code>{FLECS_COMMIT}</code>, {FLECS_DATE}), with a trace hooked into its internals.
      Step through it and you see what the docs describe: rows moving between tables, the last row swapped into the hole, commands
      waiting for a sync point, caches being told about new tables, and observers firing in order. Later lessons add playgrounds
      and benchmarks you can run on the same build.
    </p>
    <a class="sandbox-card" href="/flecs/sandbox/">
      <span class="t">Open the sandbox →</span>
      <span class="s">A live world to play with: create entities, add and remove components (including Sparse and DontFragment ones), add observers and systems, and watch archetypes and observer calls update as you go.</span>
    </a>
    {
      parts.map((p) => (
        <section class="part">
          {p.name && <h2 class="part-h">{p.name}</h2>}
          <ol class="lesson-list" start={p.lessons[0].n}>
            {p.lessons.map((l) => (
              <li>
                <a href={l.url}>
                  <span class="n">{l.n}</span>
                  <span class="t">{l.title}</span>
                  <span class="s">{l.summary}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
    <section id="learn-more" class="lesson learn-more">
      <LearnMore />
    </section>
    <p class="fine">
      Lessons assume you've written some code against an ECS before. Examples are shown in C++; the same operations exist in C, C#
      and Rust. Not affiliated with the flecs project.
    </p>
  </main>
</Base>

<style>
  .flecs-index {
    max-width: 900px;
    margin: 0 auto;
    padding: 16px 0 80px;
  }
  .part-h {
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 28px 0 10px;
  }
  .flecs-index h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 4px 0 12px;
  }
  .kicker {
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }
  .lede {
    color: var(--body);
    font-size: 1.05rem;
    max-width: 70ch;
  }
  .sandbox-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 24px;
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--paper));
    color: inherit;
    text-decoration: none;
  }
  .sandbox-card .t {
    color: var(--accent);
    font-weight: 500;
    font-size: 1.1rem;
  }
  .lesson-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .lesson-list a {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    gap: 2px 12px;
    padding: 14px 18px;
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
  }
  .lesson-list a:hover {
    border-color: var(--accent);
  }
  .n {
    grid-row: span 2;
    font-family: var(--f-mono);
    color: var(--accent);
    font-size: 1.2rem;
  }
  .t {
    color: var(--ink);
    font-weight: 500;
    font-size: 1.05rem;
  }
  .s {
    color: var(--body);
    font-size: 0.92rem;
  }
  .fine {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
