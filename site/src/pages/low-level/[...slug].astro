---
/**
 * The engine section used to live at /low-level/. Every old address (the index and each
 * lesson) gets a tiny page that forwards to the same place under /engine/, keeping any
 * ?query and #anchor. For a real 301, add the nginx rewrite from the README as well.
 */
export function getStaticPaths() {
  const lessons = Object.keys(import.meta.glob('../engine/*.mdx')).map((f) => f.split('/').pop()!.replace(/\.mdx$/, ''));
  return [{ params: { slug: undefined } }, ...lessons.map((slug) => ({ params: { slug } }))];
}
const { slug } = Astro.params;
const target = `/engine/${slug ? `${slug}/` : ''}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Moved to {target}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <p>This page moved to <a href={target}>{target}</a>.</p>
  </body>
</html>
